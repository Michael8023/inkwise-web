{
  "name": "pdf-ai-reader",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:extension": "npm --workspace apps/extension run dev",
    "build:extension": "npm --workspace apps/extension run build",
    "dev:api": "npm --workspace apps/api run dev",
    "test": "npm run test --workspaces",
    "dev:mobile": "npm --workspace @pdf-ai-reader/mobile run start",
    "build:mobile": "npm --workspace @pdf-ai-reader/mobile run build:reader",
    "typecheck:mobile": "npm --workspace @pdf-ai-reader/mobile run typecheck"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4"
  }
}
